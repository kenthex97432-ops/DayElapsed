<?xml version="1.0" encoding="utf-8"?>
<!-- Thème Vectorheart : vecteurs plats, angles à 45°, typo technique, haut contraste.
     La marge extérieure garde le dessin à l'intérieur de l'arrondi que certains
     écrans d'accueil appliquent aux widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/vh_safe_inset">

    <!-- Corps de la carte : rail gauche | contenu | rail droit.
         Les rails n'apparaissent qu'avec plusieurs dates et prennent la place des marges. -->
    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vh_bg"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/rail_prev"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/arrow_prev"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rail_prev_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:paddingHorizontal="3dp"
            android:src="@drawable/vh_rail_prev" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- En-tête : repère, nom, signe T+/T− -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/vh_triangle" />

            <TextView
                android:id="@+id/vh_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="ARRÊT TABAC"
                android:textColor="@color/vh_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vh_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="02/05"
                android:textColor="@color/vh_text_dim"
                android:textSize="8sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/vh_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="T+"
                android:textColor="@color/vh_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Graduations -->
        <FrameLayout
            android:id="@+id/vh_ruler"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/vh_ruler" />

        <!-- Le compteur et le panneau de données -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/days_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="320sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-condensed"
                android:gravity="bottom|start"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="128"
                android:textColor="@color/vh_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vh_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/vh_panel_bracket"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/vh_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="→200"
                    android:textColor="@color/vh_accent"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/vh_gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/vh_weeks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="SEM  18"
                    android:textColor="@color/vh_text"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/vh_months"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="MOIS 4"
                    android:textColor="@color/vh_text"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/vh_years"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="ANS  0,4"
                    android:textColor="@color/vh_text"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Unité -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginEnd="6dp"
                android:background="@color/vh_accent" />

            <TextView
                android:id="@+id/days_unit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center_vertical"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="JOURS"
                android:textColor="@color/vh_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pied : bandes de signalisation + date -->
        <LinearLayout
            android:id="@+id/vh_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/vh_stripes" />

            <TextView
                android:id="@+id/days_since"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="DEPUIS 03.06.2026"
                android:textColor="@color/vh_text_dim"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/rail_next"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:contentDescription="@string/arrow_next"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rail_next_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:paddingHorizontal="3dp"
            android:src="@drawable/vh_rail_next" />
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
