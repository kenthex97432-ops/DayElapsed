<?xml version="1.0" encoding="utf-8"?>
<!-- Thème Vectorheart : vecteurs plats, angles à 45°, typo technique, haut contraste. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vh_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- En-tête : repère, nom, signe T+/T− -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/vh_triangle" />

            <TextView
                android:id="@+id/vh_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="ARRÊT TABAC"
                android:textColor="@color/vh_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vh_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="T+"
                android:textColor="@color/vh_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Graduations -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/vh_ruler" />

        <!-- Le compteur -->
        <TextView
            android:id="@+id/days_number"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="76sp"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="128"
            android:textColor="@color/vh_text"
            android:textStyle="bold" />

        <!-- Unité -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="3dp"
                android:layout_marginEnd="6dp"
                android:background="@color/vh_accent" />

            <TextView
                android:id="@+id/days_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="JOURS"
                android:textColor="@color/vh_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pied : bandes de signalisation + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/vh_stripes" />

            <TextView
                android:id="@+id/days_since"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="DEPUIS 03.06.2026"
                android:textColor="@color/vh_text_dim"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
